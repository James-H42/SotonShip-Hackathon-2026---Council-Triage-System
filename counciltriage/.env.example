# Copy to .env.local and adjust. Every value is optional for local development.

# Where the SQLite database and uploaded photos live (default ./data).
# DATA_DIR=./data

# Folder containing reports.jsonl / reports_trimmed.jsonl and photos/ from the FixMyStreet scrape.
# Optional: without it, `npm run seed` loads only the synthetic reports.
# FMS_DATA_DIR="../../FixMyStreet Scraper/fixmystreet_sample"

# The two live-demo accounts are created by `npm run seed` and stored in .secrets/demo-accounts.json
# (git-ignored; created with random passwords on first run). These optional overrides win over that file.
# OFFICER_EMAIL=officer@counciltriage.test
# OFFICER_PASSWORD=
# OFFICER_NAME=Sam Patel
# RESIDENT_EMAIL=resident@counciltriage.test
# RESIDENT_PASSWORD=
# RESIDENT_FIRST_NAME=Alex
# RESIDENT_LAST_NAME=Morgan

# Signs session cookies. Generated into data/.session-secret if unset.
# SESSION_SECRET=

# Shared secret the external AI services send as the `x-integration-key` header.
# Required in production; integration endpoints are open in development when unset.
# INTEGRATION_API_KEY=

# Push mode: set these to have new reports sent to the external services as soon as they are submitted.
# Leave unset to use pull mode (GET /api/integrations/queue).
# LLM_TRIAGE_URL=http://localhost:8001/triage
# VISION_API_URL=http://localhost:8002/classify
# INTEGRATION_TIMEOUT_MS=15000

# Category confidence below which reports go to the TBC review queue.
# TBC_CONFIDENCE_THRESHOLD=0.5

# what3words API key for the resident location search (///word.word.word). Server-side only; never exposed to the browser.
# Free key: https://developer.what3words.com. Without it, what3words search shows a "not configured" message.
# W3W_API_KEY=

# Road routing for crew routes (OSRM). Default: the public OSRM server; point at a council-hosted one.
# OSRM_URL=https://router.project-osrm.org
